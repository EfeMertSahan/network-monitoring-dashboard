DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/network_monitor

PING_COUNT=2
PING_TIMEOUT=2

MONITORING_INTERVAL_SECONDS=30
MAX_CONCURRENT_DEVICES=20

HIGH_LATENCY_THRESHOLD_MS=100
HIGH_PACKET_LOSS_THRESHOLD_PERCENT=20
HIGH_CPU_THRESHOLD_PERCENT=80
HIGH_RAM_THRESHOLD_PERCENT=80
HIGH_DISK_THRESHOLD_PERCENT=80

CREDENTIAL_ENCRYPTION_KEY=

SSH_RETRIES=3
SSH_TIMEOUT=5